  "sdkFindings": [
    {
      "observation": "The checked surface provides entity_set_pos and a render camera setter.",
      "limitation": "No promise of off-map navigation, rendering or camera-follow behaviour."
    },
    {
      "observation": "The checked StablePassive::on_damaged receives an immutable damage value after damage.",
      "limitation": "It is not a universal pre-impact cancellation or shield-hit identity hook."
    },
    {
      "observation": "The checked banish operation is documented as untargetable, invisible and input-locked.",
      "limitation": "Full dodge and normal playable isolated duels cannot be assumed from that operation."
    },
    {
      "observation": "The map customizer documents original offline pathfinding/visibility geometry.",
      "limitation": "Extending a wall document alone does not establish an off-map navigable arena."
    }
  ],
  "mandatoryHostProof": [
    {
      "id": "offMapWorld",
      "requirement": "Stock/custom movement, targeting, ordinary attacks, casts and summons outside map bounds",
      "status": "unproven"
    },
    {
      "id": "interactionIsolation",
      "requirement": "Block new cross-arena damage, support, control and global effects",
      "status": "unproven"
    },
    {
      "id": "boundaryEnforcement",
      "requirement": "All movement, forced movement and stock/custom teleports respect ring geometry",
      "status": "unproven"
    },
    {
      "id": "exactReturn",
      "requirement": "Live death/timeout/partial failure restore exact recorded coordinates",
      "status": "unproven"
    },
    {
      "id": "constructionReservations",
      "requirement": "All relevant solid construction routes reject reserved footprints",
      "status": "unproven"
    },
    {
      "id": "cameraReplay",
      "requirement": "Existing champion-follow or optional Ring View, plus replay seek",
      "status": "unproven"
    },
    {
      "id": "fullDodge",
      "requirement": "Targeting, physical/magic/fixed damage, DoT and new control at exact window boundaries",
      "status": "unproven"
    },
    {
      "id": "shieldHitIdentity",
      "requirement": "Reliable attacker/impact identity including fully shield-absorbed hits",
      "status": "unproven"
    }
  ],
