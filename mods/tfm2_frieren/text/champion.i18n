{
  "en": {
    "description": {
      "tfm2_frieren_frieren": {
        "name": "Frieren",
        "skill": "Zoltraak: piercing basic attack (20 + 45% AP), every 1.2s. Concealed Mana: 100 mana, recovering 8/s while alive. Spellcraft: quick shot (50 + 70% AP, 0.35s preparation, 15 mana) or charged shot (85 + 100% AP, 1s preparation, 35 mana). Shared cooldown 4s, spent with mana when preparation starts; disruption cancels the shot.",
        "skill2": "Defensive Magic: a breakable shield for Frieren or an ally within 60000 (90 + 45% AP), lasting 1.5s. Costs 30 mana; cooldown 10s. Battle Reading selects protection and firing opportunities using visible actions.",
        "ult": "Journey’s Companions: 8s of revealed mana (+25% AP, +15% attack speed, +15000 range, 12 mana/s). Fern fires at the selected visible target every 3s (35 + 55% AP). Targetable Stark guards Frieren or her protected ally for 12s: 300 + 25% of her maximum HP, 20 armour, 15 MR, attacks for 40 + 45% AP every 1.5s, 90000 pursuit leash. Normal skills remain available. Cooldown 60s; requires ultimate unlock."
      }
    }
  }
}
